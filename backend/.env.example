# Supabase PostgreSQL connection string
# Obtenha em: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# JWT - gere um segredo forte: openssl rand -hex 64
JWT_SECRET="substitua_por_um_segredo_forte_aqui"
JWT_EXPIRES_IN="7d"

# Porta da API
PORT=3000

# Usuario administrador inicial criado pelo seed
ADMIN_INITIAL_EMAIL="admin@local"
ADMIN_INITIAL_PASSWORD="troque_esta_senha"
